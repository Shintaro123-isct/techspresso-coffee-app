# Share only application sources, portable tests and team documentation.
# Existing production exports, screenshots, reports and credentials stay local.
/*
!/.gitignore
!/.gitattributes
!/package.json
!/package-lock.json
!/build.mjs
!/README.md
!/CONTRIBUTING.md
!/docs/
/docs/*
!/docs/CLOUDFLARE_MIGRATION.md
!/docs/GITHUB_SETUP.md
!/docs/CLOUDFLARE_SETUP.md
!/cloudflare/
/cloudflare/*
!/cloudflare/worker.mjs
!/cloudflare/build.mjs
!/cloudflare/migrations/
!/wrangler.jsonc
!/src/
/src/*
!/src/core.js
!/src/backend.gs
!/src/alerts.gs
!/src/client.js
!/src/styles.css
!/src/Index.html
!/assets/
/assets/*
!/assets/techspresso-official.png
!/discord-relay/
/discord-relay/*
!/discord-relay/worker.mjs
!/tests/
/tests/*
!/tests/core.test.mjs
!/tests/backend.test.mjs
!/tests/client.test.mjs
!/tests/alerts.test.mjs
!/tests/discord-relay.test.mjs
!/tests/cloudflare.test.mjs
!/.github/
/.github/*
!/.github/workflows/
!/.github/pull_request_template.md
/.github/workflows/*
!/.github/workflows/check.yml

# Never include live settings or credentials, even under an allowed directory.
**/.env
**/.env.*
**/.dev.vars
**/.dev.vars.*
**/.clasp.json
**/.clasprc.json
**/node_modules/
**/secrets/
**/credentials/
**/*.pem
**/*.key
**/*.p12
**/*.pfx

{
  "name": "techspresso-festival-handover",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "npm run test:unit && npm run test:cloudflare",
    "test:unit": "node --test tests/core.test.mjs tests/backend.test.mjs tests/client.test.mjs tests/alerts.test.mjs tests/discord-relay.test.mjs",
    "build:cloudflare": "node cloudflare/build.mjs",
    "test:cloudflare": "npm run build:cloudflare && node --test tests/cloudflare.test.mjs",
    "dev:cloudflare": "npm run build:cloudflare && wrangler dev",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "4.151.2"
  }
}
